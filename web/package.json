{
  "name": "shelfmark-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "gen:api": "openapi-typescript ../api/openapi.yaml -o src/api/schema.d.ts --default-non-nullable false",
    "gen:icons": "node scripts/gen-icons.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:real": "playwright test -c playwright.real.config.ts",
    "size": "node scripts/size.mjs"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0",
    "svelte": "^5.57.3"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.9",
    "@types/node": "^26.6.6",
    "fake-indexeddb": "^6.2.8",
    "msw": "^3.0.5",
    "openapi-typescript": "^7.13.0",
    "svelte-check": "^4.7.8",
    "typescript": "~5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
