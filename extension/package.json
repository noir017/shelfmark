{
  "name": "shelfmark-extension",
  "version": "0.1.0",
  "private": true,
  "description": "shelfmark browser extension (Chrome, Edge, Brave, Firefox)",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "gen:api": "openapi-typescript ../api/openapi.yaml -o src/api/schema.d.ts --default-non-nullable false",
    "gen:icons": "node scripts/gen-icons.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && node scripts/build.mjs",
    "test": "npm run test:unit && npm run test:e2e && npm run lint:firefox",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:real": "playwright test -c playwright.real.config.ts",
    "lint:firefox": "web-ext lint --source-dir dist/firefox --self-hosted --warnings-as-errors",
    "package": "node scripts/package.mjs",
    "fake-server": "node test/fake-server/cli.mjs"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/chrome": "0.3.7",
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vitest": "5.1.0",
    "web-ext": "10.8.0"
  },
  "allowScripts": {
    "esbuild": false
  }
}
